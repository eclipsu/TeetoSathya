# Copy to .env and fill in. Dev defaults shown where safe.
PORT=3001
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Your machine's LAN IP (used for livekit --node-ip and printed links)
LAN_HOST=

# Server-only. Never prefix these with VITE_ (that would ship them to the browser).
# Realtime speech-to-text for the active hot-seat speaker.
ELEVENLABS_API_KEY=
# Claim extraction and the Gemini evidence juror. Server only.
GEMINI_API_KEY=
# Optional duplicate of GEMINI_API_KEY. Used if GEMINI_API_KEY is empty.
GEMINI_FACTS_KEY=
# Claude skeptic juror. ANTHROPIC_API_KEY is also accepted. Server only.
CLAUDE_API_KEY=
# Optional model overrides.
GEMINI_MODEL=
ANTHROPIC_MODEL=

# Hosted SpacetimeDB Maincloud. The app does not start a local database.
# Public. The browser may see these. Default host is the official Maincloud URL.
# Database name: add the name shown on your database page at spacetimedb.com.
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DATABASE=
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=
# Server-only. Identity token for the account that owns the hosted database.
# After `spacetime login`, run `spacetime login show --token` and put that value here.
# Do not prefix this with VITE_. Do not commit .env.
SPACETIMEDB_TOKEN=
