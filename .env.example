# Copy to .env and fill in. Dev defaults shown where safe.
PORT=3001
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Your machine's LAN IP (used for livekit --node-ip and printed links)
LAN_HOST=

# Server-only. Never prefix these with VITE_ (that would ship them to the browser).
# Realtime speech-to-text for the active hot-seat speaker.
ELEVENLABS_API_KEY=
# Extracts challengeable claims from finalized speech. Does not judge them.
GEMINI_API_KEY=
# Gemini juror (evidence analyst). Also used as the Gemini jury key.
GEMINI_FACTS_KEY=
# Claude juror (skeptic). Server only. Not called while claude is absent from JURY_SEATS.
ANTHROPIC_API_KEY=
# ChatGPT juror (logic / referee). Server only. Same voting power as the other two.
OPENAI_API_KEY=
# Optional model overrides.
GEMINI_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
